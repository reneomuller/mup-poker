{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "v2-*": false,
      "v3-*": false,
      "v4-*": false,
      "v2-base": false,
      "v2-server": false,
      "v2-phone": false,
      "v2-table": false,
      "v2-admin": false,
      "v2-qa": false,
      "v2-int": false
    }
  }
}
